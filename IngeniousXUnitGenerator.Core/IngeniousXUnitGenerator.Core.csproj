<Project Sdk="Microsoft.NET.Sdk">

  <!-- VS内蔵のRoslynとのアセンブリ競合を避けるため、RefactoringProviderからも読めるnetstandard2.0にする -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>IngeniousXUnitGenerator.Core</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" />
    <PackageReference Include="CSharp_IngeniousAnalyzer" Version="3.4.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
