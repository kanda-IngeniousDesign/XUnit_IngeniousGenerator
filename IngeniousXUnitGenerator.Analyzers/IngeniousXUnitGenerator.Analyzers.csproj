<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <RootNamespace>IngeniousXUnitGenerator.Analyzers</RootNamespace>
    <Version>0.1.0-dev</Version>
    <Description>C#のクラス・メソッドから、xUnitのテストコードをRoslynだけで決定的に生成するリファクタリングです。</Description>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\artifacts\packages</PackageOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>IngeniousXUnitGenerator</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
    <PackageReference Include="CSharp_IngeniousAnalyzer" Version="3.4.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IngeniousXUnitGenerator.Core\IngeniousXUnitGenerator.Core.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- Coreはホスト（VS / VS Code）が持たないため、本体と同じフォルダに同梱して一緒に読み込ませる -->
  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false" />
    <None Include="$(OutputPath)\IngeniousXUnitGenerator.Core.dll" Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false" />
  </ItemGroup>

</Project>
