<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- 同じバージョンを作り直しても古いものが使われないよう、パッケージはこのフォルダ内に展開する -->
    <add key="globalPackagesFolder" value=".packages" />
  </config>
  <packageSources>
    <add key="local" value="../../artifacts/packages" />
  </packageSources>
</configuration>
