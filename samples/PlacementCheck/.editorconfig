[*.cs]
# サンプルでは TEST001（自動生成できるテストの不足）と TEST002（自動生成できない関数）を有効にする（既定では無効）
dotnet_diagnostic.TEST001.severity = warning
dotnet_diagnostic.TEST002.severity = warning

# サンプルを TEST001・TEST002 の確認に絞るため、ほかのルールは止める
dotnet_diagnostic.COMM001.severity = none
dotnet_diagnostic.COMM002.severity = none
dotnet_diagnostic.COMP001.severity = none
