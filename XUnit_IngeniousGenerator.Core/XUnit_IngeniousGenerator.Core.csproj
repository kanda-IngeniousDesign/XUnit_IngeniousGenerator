<Project Sdk="Microsoft.NET.Sdk">

  <!--
    テストコード生成のエンジン。単独のパッケージにはせず、XUnit_IngeniousGenerator（アナライザー）のパッケージに同梱する。
    VS内蔵のRoslynから読み込まれるため netstandard2.0 にする
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>XUnit_IngeniousGenerator.Core</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" PrivateAssets="all" />
    <PackageReference Include="CSharp_IngeniousAnalyzer" Version="3.4.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
