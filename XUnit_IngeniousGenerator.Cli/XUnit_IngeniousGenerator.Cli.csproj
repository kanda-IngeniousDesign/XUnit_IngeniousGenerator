<Project Sdk="Microsoft.NET.Sdk">

  <!-- LTSのnet8.0でビルドし、新しいランタイムしかない環境でも動くようにロールフォワードを許可する -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <RootNamespace>XUnit_IngeniousGenerator.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ingenious-xunit</ToolCommandName>
    <PackageId>XUnit_IngeniousGenerator.Cli</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CSharp_IngeniousAnalyzer" Version="3.4.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XUnit_IngeniousGenerator.Core\XUnit_IngeniousGenerator.Core.csproj" />
  </ItemGroup>

</Project>
